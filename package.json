{
  "name": "stack-pr",
  "private": true,
  "version": "0.0.0",
  "description": "Visualize your GitHub PR stacks as an interactive dependency tree.",
  "main": "app/main.js",
  "scripts": {
    "dev": "next dev renderer -p 8888",
    "dev:app": "nextron",
    "icons": "node scripts/make-icons.mjs",
    "build": "nextron build",
    "build:mac": "nextron build --mac && ./scripts/make-dmg.sh arm64",
    "build:win": "nextron build --win",
    "build:linux": "nextron build --linux",
    "lint": "next lint --dir renderer",
    "typecheck:main": "tsc --noEmit -p tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p renderer/tsconfig.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer"
  },
  "dependencies": {
    "electron-serve": "^1.3.0",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@xyflow/react": "^12.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "nextron": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.3"
  }
}
